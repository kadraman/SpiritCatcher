{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Release",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "ZGB_PATH": "${workspaceFolder}/deps/CrossZGB/common",
                    "GBDK_HOME": "${workspaceFolder}/deps/gbdk"
                }
            },
            "isBackground": false,
            "args": [
                "BUILD_TYPE=Release",
                "gbc"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Debug",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "ZGB_PATH": "${workspaceFolder}/deps/CrossZGB/common",
                    "GBDK_HOME": "${workspaceFolder}/deps/gbdk"
                }
            },
            "isBackground": false,
            "args": [
                "BUILD_TYPE=Debug",
                "gbc"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "ZGB_PATH": "${workspaceFolder}/deps/CrossZGB/common",
                    "GBDK_HOME": "${workspaceFolder}/deps/gbdk"
                }
            },
            "isBackground": false,
            "args": [
                "BUILD_TYPE=Debug",
                "gbc-clean"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Bootstrap",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/bootstrap.sh",
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/scripts/bootstrap.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Ensure Emulicious",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/bootstrap.sh --with-emulicious",
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/scripts/bootstrap.ps1",
                    "-WithEmulicious"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
