{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/bin/gbc/rom_Debug.gbc",
            "port": 58870,
            "stopOnEntry": false,
            "additionalSrcFolders": "${workspaceFolder}/deps/CrossZGB/common;${workspaceFolder}/include;${workspaceFolder}/src",
            "emuliciousPath": "${workspaceFolder}/tools/emulicious/Emulicious.jar",
            "preLaunchTask": "Debug",
            "internalConsoleOptions": "openOnSessionStart",
            "maxAttempts": 40
        },
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Release",
            "program": "${workspaceFolder}/bin/gbc/rom.gbc",
            "port": 58870,
            "stopOnEntry": false,
            "additionalSrcFolders": "${workspaceFolder}/deps/CrossZGB/common;${workspaceFolder}/include;${workspaceFolder}/src",
            "emuliciousPath": "${workspaceFolder}/tools/emulicious/Emulicious.jar",
            "preLaunchTask": "Release",
            "internalConsoleOptions": "openOnSessionStart",
            "maxAttempts": 40
        },
        {
            "type": "emulicious-debugger",
            "request": "attach",
            "name": "Attach to Emulicious",
            "port": 58870,
            "additionalSrcFolders": "${workspaceFolder}/deps/CrossZGB/common;${workspaceFolder}/include;${workspaceFolder}/src",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
