        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Release",
            "program": "${workspaceFolder}/bin/gbc/rom.gbc",
            "port": 58870,
            "stopOnEntry": false,
            "additionalSrcFolders": "${workspaceFolder}/deps/CrossZGB/common",
            "emuliciousPath": "${workspaceFolder}/tools/emulicious/Emulicious.jar",
            "preLaunchTask": "Release"
        }
    ]
}
