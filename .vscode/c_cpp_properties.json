{
    "configurations": [
        {
            "name": "SpiritCatcher",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/deps/CrossZGB/common/include",
                "${workspaceFolder}/deps/gbdk/include/**",
                "${env:ZGB_PATH}/include",
                "${env:GBDK_HOME}/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "__PORT_gbz80",
                "CGB"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}"
        }
    ],
    "version": 4
}
